{
  "name": "email-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile Gmail triage dashboard with inline reply",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "prepare": "node -e \"try{if(process.env.CI||process.env.NODE_ENV==='production')process.exit(0);require('fs').existsSync('.git')&&require('./scripts/install-git-hooks.js')}catch(e){}\"",
    "check:all": "node scripts/run-pre-push-checks.js",
    "check:subh-language": "node scripts/check-subh-language.js",
    "check:whatsapp-engine": "node scripts/check-whatsapp-engine.js",
    "check:whatsapp-scenarios": "node scripts/check-whatsapp-scenarios.js",
    "check:reminders": "node scripts/check-reminders.js",
    "check:automation": "node scripts/check-automation.js",
    "check:automation-nlu": "node scripts/check-automation-nlu.js",
    "check:mail-compose": "node scripts/check-mail-compose.js",
    "check:subh-panel-ui": "node scripts/check-subh-panel-ui.js",
    "check:company-details": "node scripts/check-company-details.js",
    "check:ai-usage-log": "node scripts/check-ai-usage-log.js",
    "check:letter-settings": "node scripts/check-letter-settings.js",
    "check:drive-templates": "node scripts/check-drive-templates.js",
    "check:drive-template-fields": "node scripts/check-drive-template-fields.js",
    "check:drive-template-generation": "node scripts/check-drive-template-generation.js",
    "check:workflow": "node scripts/check-workflow.js",
    "check:workflow-nlu": "node scripts/check-workflow-nlu.js"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@upstash/redis": "^1.39.0",
    "chart.js": "^4.5.1",
    "docx": "^9.8.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "googleapis": "^140.0.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  }
}
